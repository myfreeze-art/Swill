<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/small_margin"
    app:cardCornerRadius="@dimen/stroke_width"
    app:cardElevation="@dimen/card_elevation"
    app:cardBackgroundColor="@color/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/default_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvServerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Server Name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurface" />

                <TextView
                    android:id="@+id/tvServerAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="192.168.1.1:443"
                    android:textSize="14sp"
                    android:textColor="@color/colorOnSurface"
                    android:layout_marginTop="@dimen/small_margin" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/small_margin">

                    <TextView
                        android:id="@+id/tvProtocol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VLESS"
                        android:textSize="12sp"
                        android:background="@drawable/bg_protocol_vless"
                        android:paddingHorizontal="@dimen/small_margin"
                        android:paddingVertical="2dp" />

                    <TextView
                        android:id="@+id/tvCore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="X-RAY"
                        android:textSize="12sp"
                        android:layout_marginLeft="@dimen/small_margin"
                        android:background="@drawable/bg_core_xray"
                        android:paddingHorizontal="@dimen/small_margin"
                        android:paddingVertical="2dp" />

                    <TextView
                        android:id="@+id/tvPing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="?"
                        android:textSize="12sp"
                        android:layout_marginLeft="@dimen/small_margin"
                        android:background="@color/colorSurface"
                        android:paddingHorizontal="@dimen/small_margin"
                        android:paddingVertical="2dp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/colorPrimary"
                    android:textColor="@android:color/white"
                    android:minWidth="0"
                    android:minHeight="0"
                    android:padding="@dimen/small_margin" />

                <Button
                    android:id="@+id/btnPing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ping"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/colorAccent"
                    android:textColor="@android:color/white"
                    android:layout_marginLeft="@dimen/small_margin"
                    android:minWidth="0"
                    android:minHeight="0"
                    android:padding="@dimen/small_margin" />

                <Button
                    android:id="@+id/btnDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/colorError"
                    android:textColor="@android:color/white"
                    android:layout_marginLeft="@dimen/small_margin"
                    android:minWidth="0"
                    android:minHeight="0"
                    android:padding="@dimen/small_margin" />
            </LinearLayout>

        </LinearLayout>

        <!-- Selected indicator -->
        <View
            android:id="@+id/viewSelected"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/colorPrimary"
            android:visibility="gone"
            android:layout_marginTop="@dimen/default_margin" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
