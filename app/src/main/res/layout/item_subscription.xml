<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/small_margin"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardBackgroundColor="@color/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/default_margin">

        <TextView
            android:id="@+id/tvSubscriptionName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subscription Name"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface" />

        <TextView
            android:id="@+id/tvSubscriptionUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://example.com/subscription"
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/colorOnSurfaceVariant"
            android:layout_marginTop="@dimen/small_margin" />

        <TextView
            android:id="@+id/tvSubscriptionLastUpdated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Updated: Never"
            android:textSize="@dimen/text_size_tiny"
            android:textColor="@color/colorOnSurfaceVariant"
            android:layout_marginTop="@dimen/small_margin" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/default_margin"
            android:layout_gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdate"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:text="Update"
                android:textSize="@dimen/text_size_tiny"
                android:textAllCaps="false"
                style="@style/ButtonStyle.Primary"
                android:textColor="@android:color/white"
                android:minWidth="0"
                android:minHeight="0"
                android:padding="@dimen/small_margin" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:text="Delete"
                android:textSize="@dimen/text_size_tiny"
                android:textAllCaps="false"
                style="@style/ButtonStyle.Error"
                android:textColor="@android:color/white"
                android:layout_marginLeft="@dimen/small_margin"
                android:minWidth="0"
                android:minHeight="0"
                android:padding="@dimen/small_margin" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
