<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="@dimen/default_margin"
    tools:context=".ui.SettingsActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/large_margin">

            <!-- Title -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface"
                android:layout_marginBottom="@dimen/large_margin" />

            <!-- Auto Connect Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/default_margin"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/default_margin">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto Connect"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoConnect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/small_margin" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connect to VPN automatically when the app starts"
                        android:textSize="12sp"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:layout_marginTop="@dimen/small_margin" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Auto Update Subscriptions Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/default_margin"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/default_margin">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto Update Subscriptions"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoUpdateSubscriptions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/small_margin" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Automatically update all subscriptions when the app starts"
                        android:textSize="12sp"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:layout_marginTop="@dimen/small_margin" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Auto Ping Servers Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/default_margin"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/default_margin">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto Ping Servers"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoPingServers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/small_margin" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ping all servers automatically when the app starts to show latency"
                        android:textSize="12sp"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:layout_marginTop="@dimen/small_margin" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Default Core Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/default_margin"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/default_margin">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default VPN Core"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface" />

                    <RadioGroup
                        android:id="@+id/coreSelector"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/small_margin">

                        <RadioButton
                            android:id="@+id/rbXray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="X-ray"
                            android:textSize="14sp"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rbSingBox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sing-box"
                            android:textSize="14sp"
                            android:layout_marginLeft="@dimen/default_margin" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hysteria2 only works with Sing-box core"
                        android:textSize="12sp"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:layout_marginTop="@dimen/small_margin" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ping Method Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/default_margin"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/default_margin">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ping Method"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface" />

                    <RadioGroup
                        android:id="@+id/pingMethodSelector"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/small_margin">

                        <RadioButton
                            android:id="@+id/rbPingHttp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HTTP"
                            android:textSize="14sp"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rbPingTcp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TCP"
                            android:textSize="14sp"
                            android:layout_marginLeft="@dimen/default_margin" />

                        <RadioButton
                            android:id="@+id/rbPingIcmp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ICMP"
                            android:textSize="14sp"
                            android:layout_marginLeft="@dimen/default_margin" />

                        <RadioButton
                            android:id="@+id/rbPingDns"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DNS"
                            android:textSize="14sp"
                            android:layout_marginLeft="@dimen/default_margin" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select the default method for pinging servers"
                        android:textSize="12sp"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:layout_marginTop="@dimen/small_margin" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Split Tunneling Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/default_margin"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/default_margin">

                    <Button
                        android:id="@+id/btnSplitTunnel"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:text="Split Tunneling"
                        android:textSize="16sp"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/colorPrimary"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configure which apps use VPN and which bypass it"
                        android:textSize="12sp"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:layout_marginTop="@dimen/small_margin" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Back Button -->
            <Button
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="Back"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/colorSurface"
                android:layout_marginTop="@dimen/large_margin" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
